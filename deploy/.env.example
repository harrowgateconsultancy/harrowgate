# ─────────────────────────────────────────────────────────────────────────────
# HARROWGATE — Self-Hosted Environment Variables
# Copy this file to deploy/.env and fill in every value before starting.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Strong password for the internal Postgres container (min 16 chars recommended)
POSTGRES_PASSWORD=change_me_strong_db_password_here

# ── App ───────────────────────────────────────────────────────────────────────
# Port exposed on your NAS (access the site at http://NAS-IP:APP_PORT)
APP_PORT=3000

# Secret used to sign student login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDENT_JWT_SECRET=change_me_random_64_char_hex_string

# Admin panel password (used to log in at /admin)
ADMIN_PASSWORD=change_me_admin_password_here

# ── Google OAuth (for "Sign in with Google") ──────────────────────────────────
# Create credentials at https://console.cloud.google.com/
# Authorized redirect URI must be:
#   http://NAS-IP:3000/api/student/auth/google/callback
#   OR https://yourdomain.com/api/student/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# If you have a fixed domain/IP, explicitly set the redirect URI here
# (otherwise the app auto-detects it from the request host)
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/student/auth/google/callback

# ── Gmail notifications ────────────────────────────────────────────────────────
# Use an App Password (not your Gmail login password).
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

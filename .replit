modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 20089
externalPort = 80

[userenv]

[userenv.shared]
GMAIL_USER = "harrowgateconsultancy@gmail.com"
GOOGLE_REDIRECT_URI = "https://8406eb44-1c18-45e5-825a-162971318e71-00-1zzkjoduft6kr.sisko.replit.dev/api/student/auth/google/callback"

[nix]
channel = "stable-25_05"

# ── Required: Database ────────────────────────────────────────────────────────
# Choose a strong random password for the local PostgreSQL container
DB_PASSWORD=change_me_strong_password_here

# ── Required: Admin Login ─────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password_here

# ── Required: Student Auth ────────────────────────────────────────────────────
# Secret used to sign student JWT tokens — use a long random string
STUDENT_JWT_SECRET=change_me_long_random_secret_here

# ── Optional: Port (default 3000) ─────────────────────────────────────────────
WEB_PORT=3000

# ── Optional: Google OAuth (Sign in with Google) ──────────────────────────────
# 1. Go to https://console.cloud.google.com/ → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add authorised redirect URI: https://YOUR_DOMAIN/api/student/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional: Apple Sign In ────────────────────────────────────────────────────
# Requires an Apple Developer account ($99/yr) and HTTPS on a real domain.
# 1. Create an App ID with Sign In with Apple enabled
# 2. Create a Services ID (this becomes APPLE_CLIENT_ID)
# 3. Create a Sign In with Apple key (.p8) — paste content replacing newlines with \n
# 4. Register redirect URI: https://YOUR_DOMAIN/api/student/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Optional: Frontend base path (only needed if not served at /) ──────────────
# Set to the path prefix of the frontend, e.g. /portal if served at /portal/
FRONTEND_BASE_PATH=/

# ── Optional: Gmail Notifications ─────────────────────────────────────────────
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── Optional: Google Drive & Sheets ───────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SHEETS_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── Optional: MEGA Cloud Backup ───────────────────────────────────────────────
MEGA_PASSWORD=

# ── Optional: WebDAV Storage ──────────────────────────────────────────────────
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# ── Optional: WhatsApp/CallMeBot ──────────────────────────────────────────────
CALLMEBOT_API_KEY=

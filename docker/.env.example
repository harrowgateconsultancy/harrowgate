# ── Required: Database ────────────────────────────────────────────────────────
# Choose a strong random password for the local PostgreSQL container
DB_PASSWORD=change_me_strong_password_here

# ── Required: Admin Login ─────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password_here

# ── Required: Student Auth ────────────────────────────────────────────────────
# Secret used to sign student JWT tokens — use a long random string
STUDENT_JWT_SECRET=change_me_long_random_secret_here

# ── Optional: Port (default 3000) ─────────────────────────────────────────────
WEB_PORT=3000

# ── Optional: Gmail Notifications ─────────────────────────────────────────────
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── Optional: Google Drive & Sheets ───────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SHEETS_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── Optional: MEGA Cloud Backup ───────────────────────────────────────────────
MEGA_PASSWORD=

# ── Optional: WebDAV Storage ──────────────────────────────────────────────────
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# ── Optional: WhatsApp/CallMeBot ──────────────────────────────────────────────
CALLMEBOT_API_KEY=
